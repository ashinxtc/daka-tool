{
  "name": "daka-sync-staging",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "DAKA_SYNC",
      "id": "a7d247450984452e85da87e14d79c648"
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "SYNC_MODE": "active",
    "AUTH_MODE": "enforced",
    "EXCHANGE_MODE": "preview"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_FAMILIES",
        "class_name": "SyncFamily"
      }
    ]
  },
  "migrations": [
    {
      "tag": "sync-v2-sqlite",
      "new_sqlite_classes": [
        "SyncFamily"
      ]
    }
  ]
}
