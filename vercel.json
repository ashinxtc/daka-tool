{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/wecom/:match*",
      "destination": "https://daka-wecom.2378385593.workers.dev/api/wecom/:match*"
    },
    {
      "source": "/api/family/:match*",
      "destination": "https://daka-wecom.2378385593.workers.dev/api/family/:match*"
    },
    {
      "source": "/api/push/:match*",
      "destination": "https://daka-push.2378385593.workers.dev/api/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://daka-exchange.2378385593.workers.dev/api/:match*"
    }
  ]
}
